          "weight": 1,
          "models": [
            "*"
          ]
        }
      ],
      "network_config": {
        "base_url": "http://offline:8080",
        "max_retries": 0
      },
      "custom_provider_config": {
        "base_provider_type": "openai"
      }
    }
  }
}
